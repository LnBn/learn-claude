{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/md_log.py\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/md_log.py\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/md_log.py\"", "timeout": 20 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 .claude/hooks/md_log.py *)",
      "Bash(bash .claude/scripts/render-mermaid.sh *)",
      "Bash(bash .claude/scripts/render-svg.sh *)",
      "Bash(mkdir -p /tmp/learn-viz*)",
      "Read(/tmp/learn-*)",
      "Write(/tmp/learn-viz/**)",
      "Edit(/tmp/learn-viz/**)",
      "WebSearch",
      "WebFetch"
    ]
  }
}
