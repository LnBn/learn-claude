{
  "env": {
    "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__quiz__quiz|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/md_log.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/md_log.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/interview.py\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|mcp__quiz__quiz",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/md_log.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/md_log.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__quiz__quiz",
      "Bash(python3 .claude/hooks/md_log.py *)",
      "Bash(python3 .claude/hooks/lesson.py *)",
      "Bash(python3 .claude/hooks/book.py *)",
      "Bash(python3 .claude/hooks/exam.py *)",
      "Bash(python3 .claude/hooks/coding.py *)",
      "Bash(python3 .claude/hooks/interview.py *)",
      "Bash(python3 .claude/hooks/technique.py *)",
      "Write(/tmp/learn-code-*)",
      "Bash(mkdir -p /tmp/learn-book*)",
      "Write(/tmp/learn-book/**)",
      "Bash(bash .claude/scripts/render-mermaid.sh *)",
      "Bash(bash .claude/scripts/render-svg.sh *)",
      "Bash(mkdir -p /tmp/learn-viz*)",
      "Read(/tmp/learn-*)",
      "Write(/tmp/learn-viz/**)",
      "Edit(/tmp/learn-viz/**)",
      "WebSearch",
      "WebFetch"
    ]
  }
}
